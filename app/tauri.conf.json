{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BreakBar",
  "version": "2.0.0",
  "identifier": "io.github.breakbar.windows",
  "build": { "frontendDist": "./ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "BreakBar",
        "width": 170,
        "height": 48,
        "x": 16,
        "y": 16,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
