{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BreakBar",
  "version": "2.0.0",
  "identifier": "io.github.breakbar.windows",
  "build": {
    "frontendDist": "./ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "BreakBar",
        "width": 170,
        "height": 48,
        "x": 16,
        "y": 16,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "publisher": "BreakBar",
    "shortDescription": "A floating Pomodoro timer",
    "longDescription": "BreakBar is a floating Pomodoro timer with a Rest window that takes over your screen when it is time for a break.",
    "copyright": "MIT licence",
    "license": "../LICENSE",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": [
          "English"
        ]
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  },
  "mainBinaryName": "BreakBar"
}
